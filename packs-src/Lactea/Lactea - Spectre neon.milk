MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=5.000000
fGammaAdj=1.000
fDecay=1.000
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.500
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.000
fShader=0.000
zoom=1.000
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.000
sx=1.000
sy=1.000
wave_r=1.000
wave_g=1.000
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
per_frame_1=q2 = min(max((time - tprev) * 60, 0.25), 4);
per_frame_2=tprev = time;
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=0
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.000000
wavecode_0_r=1.000000
wavecode_0_g=1.000000
wavecode_0_b=1.000000
wavecode_0_a=1.000000
wave_0_per_point1=bin = sample * 511;
wave_0_per_point2=eqpm = 0.02 * log(512 / (512 - min(bin, 511.5)));
wave_0_per_point3=db = if(above(bin, 0.5), 20 * log10(max(value1 / eqpm, 0.000001)), -200);
wave_0_per_point4=k = 32 * log(1 + bin / 80) / log(6);
wave_0_per_point5=v = min(max((db + 1.8 * k - 16) / 67, 0), 1);
wave_0_per_point6=x = (bin + 0.5) / 512;
wave_0_per_point7=y = 0.23;
wave_0_per_point8=r = v;
wave_0_per_point9=g = v;
wave_0_per_point10=b = v;
warp_1=`shader_body
warp_2=`{
warp_3=`    float rowA = 0.5 + 0.27 * aspect.w;
warp_4=`    float rowB = rowA - 0.015;
warp_5=`    float H = rowB - 0.012;
warp_6=`    float k = q2;
warp_7=`    ret = float3(0.0, 0.0, 0.0);
warp_8=`    if (uv.y > H)
warp_9=`    {
warp_10=`        if (abs(uv.y - rowB) < 0.006)
warp_11=`        {
warp_12=`            float i = floor(uv.x * 24.0);
warp_13=`            float lo = pow(400.0, i / 24.0);
warp_14=`            float hi = pow(400.0, (i + 1.0) / 24.0);
warp_15=`            float m = 0.0;
warp_16=`            m = max(m, max(tex2D(sampler_main, float2((lerp(lo, hi, 0.000) + 0.5) / 512.0, rowA)).x, tex2D(sampler_main, float2((lerp(lo, hi, 0.000) + 0.5) / 512.0, rowA - texsize.w)).x));
warp_17=`            m = max(m, max(tex2D(sampler_main, float2((lerp(lo, hi, 0.200) + 0.5) / 512.0, rowA)).x, tex2D(sampler_main, float2((lerp(lo, hi, 0.200) + 0.5) / 512.0, rowA - texsize.w)).x));
warp_18=`            m = max(m, max(tex2D(sampler_main, float2((lerp(lo, hi, 0.400) + 0.5) / 512.0, rowA)).x, tex2D(sampler_main, float2((lerp(lo, hi, 0.400) + 0.5) / 512.0, rowA - texsize.w)).x));
warp_19=`            m = max(m, max(tex2D(sampler_main, float2((lerp(lo, hi, 0.600) + 0.5) / 512.0, rowA)).x, tex2D(sampler_main, float2((lerp(lo, hi, 0.600) + 0.5) / 512.0, rowA - texsize.w)).x));
warp_20=`            m = max(m, max(tex2D(sampler_main, float2((lerp(lo, hi, 0.800) + 0.5) / 512.0, rowA)).x, tex2D(sampler_main, float2((lerp(lo, hi, 0.800) + 0.5) / 512.0, rowA - texsize.w)).x));
warp_21=`            m = max(m, max(tex2D(sampler_main, float2((lerp(lo, hi, 1.000) + 0.5) / 512.0, rowA)).x, tex2D(sampler_main, float2((lerp(lo, hi, 1.000) + 0.5) / 512.0, rowA - texsize.w)).x));
warp_22=`            float prev = tex2D(sampler_main, float2((i + 0.5) / 24.0, rowB)).y;
warp_23=`            float rise = lerp(prev, m, saturate(0.65 * k));
warp_24=`            float fall = prev - 0.022 * k;
warp_25=`            ret = float3(0.0, max(max(rise, fall), 0.0) * step(0.001, m + prev), 0.0);
warp_26=`        }
warp_27=`    }
warp_28=`    else
warp_29=`    {
warp_30=`        float2 p = float2(uv.x, uv.y / H);
warp_31=`        float2 d = p - 0.5;
warp_32=`        float a = 0.006 * sin(time * 0.37);
warp_33=`        float2 dr = float2(d.x * cos(a) - d.y * sin(a), d.x * sin(a) + d.y * cos(a));
warp_34=`        float2 src = 0.5 + dr * (0.975 - 0.015 * saturate(bass_att - 1.0));
warp_35=`        float3 fb = tex2D(sampler_main, float2(src.x, src.y * H)).xyz;
warp_36=`        fb = fb * 0.8 + (fb.yzx - fb) * 0.05;
warp_37=`        float ax = abs(p.x - 0.5) * 2.0;
warp_38=`        float bi = floor(ax * 24.0);
warp_39=`        float f = frac(ax * 24.0);
warp_40=`        float hv = tex2D(sampler_main, float2((bi + 0.5) / 24.0, rowB)).y;
warp_41=`        float hh = hv * 0.9;
warp_42=`        float ay = abs(p.y - 0.5) * 2.0;
warp_43=`        float wx = abs(f - 0.5) * 2.0;
warp_44=`        float body = (1.0 - smoothstep(0.5, 0.62, wx)) * (1.0 - smoothstep(hh - 0.01, hh + 0.01, ay)) * step(0.02, hv);
warp_45=`        float halo = exp(-max(ay - hh, 0.0) * 30.0) * exp(-max(wx - 0.55, 0.0) * 8.0) * step(0.02, hv);
warp_46=`        float t = bi / 23.0;
warp_47=`        float3 hue = 0.5 + 0.5 * cos(6.2831853 * (float3(0.0, 0.33, 0.67) + t * 0.75 + time * 0.035));
warp_48=`        float tip = saturate(ay / max(hh, 0.001));
warp_49=`        float3 neon = lerp(hue, float3(1.0, 1.0, 1.0), tip * tip * 0.55) * (0.45 + 0.55 * hv);
warp_50=`        float3 bars = neon * body + hue * halo * 0.15;
warp_51=`        float3 line = hue * exp(-ay * 80.0) * 0.2;
warp_52=`        ret = max(fb, bars + line);
warp_53=`    }
warp_54=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float rowB = 0.5 + 0.27 * aspect.w - 0.015;
comp_4=`    float H = rowB - 0.012;
comp_5=`    float2 q = float2(uv.x, uv.y * (H - 0.004));
comp_6=`    float2 d = uv - 0.5;
comp_7=`    float ca = 0.006 + 0.012 * saturate(bass_att - 1.0);
comp_8=`    float2 off = float2(d.x, d.y * H) * ca;
comp_9=`    float3 c = float3(tex2D(sampler_main, q + off).x, tex2D(sampler_main, q).y, tex2D(sampler_main, q - off).z);
comp_10=`    float3 glow = GetBlur1(q) * 0.55 + GetBlur2(q) * 0.45;
comp_11=`    float3 col = c + glow;
comp_12=`    col *= 1.0 + 0.15 * saturate(bass_att - 1.1);
comp_13=`    col *= 1.2 - dot(d, d) * 1.1;
comp_14=`    ret = col;
comp_15=`}
