per_frame_57=q27 = t4;
per_frame_58=q28 = h4;
warp_1=`float hsh(float x)
warp_2=`{
warp_3=`    return frac(sin(x * 12.9898) * 43758.5453);
warp_4=`}
warp_5=`float3 hcol(float h)
warp_6=`{
warp_7=`    float3 c = saturate(abs(frac(h + float3(0.0, 0.6666667, 0.3333333)) * 6.0 - 3.0) - 1.0);
warp_8=`    return lerp(c, float3(1.0, 1.0, 1.0), 0.2);
warp_9=`}
warp_10=`float shapeMag(float sh, float an, float h)
warp_11=`{
warp_12=`    float sphere = sqrt(max(1.0 - (2.0 * h - 1.0) * (2.0 * h - 1.0), 0.0)) * (0.4 + 0.6 * frac(h * 7.31));
warp_13=`    float ring = (0.8 + 0.4 * h) / sqrt(cos(an) * cos(an) + sin(an) * sin(an) / 0.03);
warp_14=`    float star = lerp(0.4, 1.0, step(0.5, h));
warp_15=`    float heart = 0.42 * (1.0 - sin(an)) * (0.92 + 0.08 * h);
warp_16=`    float m = sphere;
warp_17=`    m = lerp(m, ring, step(0.5, sh) * step(sh, 1.5));
warp_18=`    m = lerp(m, star, step(1.5, sh) * step(sh, 2.5));
warp_19=`    m = lerp(m, heart, step(2.5, sh));
warp_20=`    return m;
warp_21=`}
warp_22=`float trailFade(float2 p, float2 a, float2 b)
warp_23=`{
warp_24=`    float2 ab = b - a;
warp_25=`    return saturate(dot(p - a, ab) / max(dot(ab, ab), 0.0000001));
warp_26=`}
warp_27=`float segDist(float2 p, float2 a, float2 b)
warp_28=`{
warp_29=`    float2 ab = b - a;
warp_30=`    float t = saturate(dot(p - a, ab) / max(dot(ab, ab), 0.0000001));
warp_31=`    return length(p - a - ab * t);
warp_32=`}
warp_33=`shader_body
warp_34=`{
warp_35=`    float SC = 25.0 / 600.0;
warp_36=`    float2 P = float2(uv.x * texsize.x / texsize.y, 1.0 - uv.y);
warp_37=`    float3 acc = float3(0.0, 0.0, 0.0);
warp_38=`    float n;
warp_39=`    float pw;
warp_40=`    float2 org;
warp_41=`    float sh;
warp_42=`    float hu;
warp_43=`    float fn;
warp_44=`    float n2;
warp_45=`    float fn2;
warp_46=`    float hS;
warp_47=`    float tS;
warp_48=`    float hG;
warp_49=`    float tG;
warp_50=`    float life;
warp_51=`    float pbr;
warp_52=`    float2 rel;
warp_53=`    float bin0;
warp_54=`    float bn;
warp_55=`    float h1;
warp_56=`    float h2;
warp_57=`    float an;
warp_58=`    float mg;
warp_59=`    float2 dir;
warp_60=`    float2 head;
warp_61=`    float2 tail;
warp_62=`    float sd;
warp_63=`    float3 cl;
warp_64=`    n = (time - q11) * 60.0;
warp_65=`    if (q11 > 0.001 && n > 0.0 && n < 100.0)
warp_66=`    {
warp_67=`        pw = 7.0 + floor(q10) * 0.3;
warp_68=`        org = float2(q9 * texsize.x / texsize.y, frac(q10));
warp_69=`        sh = floor(q12);
warp_70=`        hu = frac(q12);
warp_71=`        fn = pow(0.96, n);
warp_72=`        n2 = max(n - 10.0, 0.0);
warp_73=`        fn2 = pow(0.96, n2);
warp_74=`        hS = 2.5 * (1.0 - fn) * pw * SC;
warp_75=`        tS = 2.5 * (1.0 - fn2) * pw * SC;
warp_76=`        hG = 0.0625 * ((1.0 - fn) / 0.04 - n) * SC;
warp_77=`        tG = 0.0625 * ((1.0 - fn2) / 0.04 - n2) * SC;
warp_78=`        life = 1.0 - n * 0.01;
warp_79=`        pbr = 1.3 + floor(q10) * 0.12;
warp_80=`        rel = P - org - float2(0.0, hG);
warp_81=`        bin0 = floor(atan2(rel.y, rel.x) / 6.2831853 * 240.0 + 120.0);
warp_82=`        bn = bin0 + -1.0;
warp_83=`        h1 = hsh(bn * 1.37 + 0.13);
warp_84=`        h2 = hsh(bn * 2.71 + 0.59);
warp_85=`        an = (bn + h1) / 240.0 * 6.2831853 - 3.1415927;
warp_86=`        mg = shapeMag(sh, an, h2);
warp_87=`        dir = float2(cos(an), sin(an)) * mg;
warp_88=`        head = org + dir * hS + float2(0.0, hG);
warp_89=`        tail = org + dir * tS + float2(0.0, tG);
warp_90=`        sd = segDist(P, tail, head);
warp_91=`        cl = hcol(hu + (h1 - 0.5) * 0.1);
warp_92=`        acc += cl * ((1.0 - smoothstep(0.0, 0.0022, sd)) * 0.55 * trailFade(P, tail, head) + (1.0 - smoothstep(0.0, 0.0042, length(P - head))) * 1.1) * saturate(life * 1.5) * pbr;
