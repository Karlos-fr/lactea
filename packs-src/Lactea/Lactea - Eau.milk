warp_1=`shader_body
warp_2=`{
warp_3=`    float2 bu = float2(uv.x * texsize.x / texsize.y, uv.y);
warp_4=`    float ct = q4 * 0.45 + 23.0;
warp_5=`    float2 cu = bu * 2.1 + float2(0.031, 0.017) * time;
warp_6=`    cu += (float2(tex2D(sampler_noise_hq, bu * 0.11 + 0.13).x, tex2D(sampler_noise_hq, bu * 0.11 + 0.61).x) - 0.5) * 0.45;
warp_7=`    float2 pc = fmod(cu * 6.2831853, 6.2831853) - 250.0;
warp_8=`    float2 ii = pc;
warp_9=`    float c = 1.0;
warp_10=`    float t;
warp_11=`    t = ct * (1.0 - 3.5 / 1.0);
warp_12=`    ii = pc + float2(cos(t - ii.x) + sin(t + ii.y), sin(t - ii.y) + cos(t + ii.x));
warp_13=`    c += 1.0 / length(float2(pc.x / (sin(ii.x + t) / 0.005), pc.y / (cos(ii.y + t) / 0.005)));
warp_14=`    t = ct * (1.0 - 3.5 / 2.0);
warp_15=`    ii = pc + float2(cos(t - ii.x) + sin(t + ii.y), sin(t - ii.y) + cos(t + ii.x));
warp_16=`    c += 1.0 / length(float2(pc.x / (sin(ii.x + t) / 0.005), pc.y / (cos(ii.y + t) / 0.005)));
warp_17=`    t = ct * (1.0 - 3.5 / 3.0);
warp_18=`    ii = pc + float2(cos(t - ii.x) + sin(t + ii.y), sin(t - ii.y) + cos(t + ii.x));
warp_19=`    c += 1.0 / length(float2(pc.x / (sin(ii.x + t) / 0.005), pc.y / (cos(ii.y + t) / 0.005)));
warp_20=`    t = ct * (1.0 - 3.5 / 4.0);
warp_21=`    ii = pc + float2(cos(t - ii.x) + sin(t + ii.y), sin(t - ii.y) + cos(t + ii.x));
warp_22=`    c += 1.0 / length(float2(pc.x / (sin(ii.x + t) / 0.005), pc.y / (cos(ii.y + t) / 0.005)));
warp_23=`    t = ct * (1.0 - 3.5 / 5.0);
warp_24=`    ii = pc + float2(cos(t - ii.x) + sin(t + ii.y), sin(t - ii.y) + cos(t + ii.x));
warp_25=`    c += 1.0 / length(float2(pc.x / (sin(ii.x + t) / 0.005), pc.y / (cos(ii.y + t) / 0.005)));
warp_26=`    c /= 5.0;
warp_27=`    c = 1.17 - pow(abs(c), 1.4);
warp_28=`    float caus = pow(abs(c), 8.0);
warp_29=`    float n1 = tex2D(sampler_noise_hq, bu * 0.35).x;
warp_30=`    float n2 = tex2D(sampler_noise_hq, bu * 1.7 + 0.31).x;
warp_31=`    float n3 = tex2D(sampler_noise_hq, bu * 7.0 + 0.77).x;
warp_32=`    float rip = 0.5 + 0.5 * sin(bu.y * 38.0 + bu.x * 9.0 + n1 * 9.0);
warp_33=`    float sand = 0.78 + 0.1 * (n1 - 0.5) + 0.08 * (n2 - 0.5) + 0.1 * (n3 - 0.5) + 0.08 * rip;
warp_34=`    float3 bottom = float3(0.93, 0.84, 0.66) * sand;
warp_35=`    float depth = saturate(0.1 + 0.3 * n1 + 0.25 * (1.0 - uv.y));
warp_36=`    float3 water = lerp(float3(0.62, 0.93, 0.9), float3(0.12, 0.5, 0.62), depth);
warp_37=`    float3 col = bottom * water + float3(0.0, 0.05, 0.08) * depth;
warp_38=`    col += float3(0.9, 1.0, 0.97) * caus * (0.9 - 0.4 * depth);
warp_39=`    float2 d = uv - 0.5;
warp_40=`    col *= 1.05 - dot(d, d) * 0.6;
warp_41=`    ret = col;
warp_42=`}
comp_1=`float hsh(float x)
comp_2=`{
comp_3=`    return frac(sin(x * 12.9898) * 43758.5453);
comp_4=`}
comp_5=`float sdbox(float2 q, float2 hs, float r)
comp_6=`{
comp_7=`    float2 e = abs(q) - hs + r;
comp_8=`    return length(max(e, 0.0)) + min(max(e.x, e.y), 0.0) - r;
comp_9=`}
comp_10=`float3 cover(float2 s)
comp_11=`{
comp_12=`    return tex2D(sampler_main, s / texsize.xy).xyz;
comp_13=`}
comp_14=`float2 ripple(float2 px, float2 dp, float age, float amp, float ringR, float unit)
comp_15=`{
comp_16=`    float2 dd = px - dp;
comp_17=`    float dist = max(length(dd), 0.001);
comp_18=`    float rr = 10.0 * unit + age * ringR;
comp_19=`    float band = 5.5 * unit + age * max(3.0 * unit, ringR * 0.086);
comp_20=`    float rd = abs(dist - rr);
comp_21=`    float amt = (1.0 - smoothstep(0.0, band, rd)) * (1.0 - age) * (1.0 - age) * sin((dist - rr) * 0.62 / unit) * amp * 2.1;
comp_22=`    float2 o = dd / dist * amt;
comp_23=`    o.y += (1.0 - smoothstep(0.0, 5.5 * unit, dist)) * amp * 1.25 * (1.0 - smoothstep(0.0, 0.16, age));
comp_24=`    return o;
comp_25=`}
comp_26=`shader_body
comp_27=`{
comp_28=`    float unit = texsize.y / 540.0;
comp_29=`    float2 px = uv * texsize.xy;
comp_30=`    float2 hs = texsize.xy * 0.5;
comp_31=`    float2 q = px - hs;
comp_32=`    float cr = 24.0 * unit;
comp_33=`    float band0 = 58.0 * unit;
comp_34=`    float strength = 18.0 * unit;
comp_35=`    float d = sdbox(q, hs, cr);
comp_36=`    float edge = max(0.0, -d);
comp_37=`    float amount = (1.0 - smoothstep(0.0, band0, edge)) * strength;
comp_38=`    amount += sin(px.x * 0.035 / unit + px.y * 0.022 / unit + time * 0.6) * 2.0 * unit * (amount / strength);
comp_39=`    float gx = sdbox(q + float2(1.0, 0.0), hs, cr) - sdbox(q - float2(1.0, 0.0), hs, cr);
comp_40=`    float gy = sdbox(q + float2(0.0, 1.0), hs, cr) - sdbox(q - float2(0.0, 1.0), hs, cr);
comp_41=`    float2 n = float2(gx, gy) / max(length(float2(gx, gy)), 0.0001);
comp_42=`    float2 off = -n * amount;
comp_43=`    float2 chroma = n * (amount / strength) * 1.35 * unit;
comp_44=`    float2 o = float2(0.0, 0.0);
comp_45=`    float tide = q1;
comp_46=`    float t = time * 0.72;
comp_47=`    float sc = 6.2831853 / (118.0 * unit);
comp_48=`    float ca = 1.8 * unit * (0.7 + 0.8 * tide);
comp_49=`    float pp = sin(px.x * sc + px.y * sc * 0.35 + t);
comp_50=`    float s2 = sin(px.y * sc * 1.2 - t * 0.72);
comp_51=`    float dg = sin((px.x + px.y) * sc * 0.62 + t * 0.48);
comp_52=`    o.x += (pp * 0.72 + dg * 0.28) * ca;
comp_53=`    o.y += (s2 * 0.62 - dg * 0.24) * ca;
comp_54=`    float sh = sin(px.x * 0.113 / unit + px.y * 0.071 / unit + t * 1.37);
comp_55=`    o += float2(sh, -sh * 0.55) * 0.18 * unit;
comp_56=`    t = q4 * 0.46;
comp_57=`    sc = 6.2831853 / (86.0 * unit);
comp_58=`    float la = 3.4 * unit * 1.35 * (0.6 + 0.8 * tide);
comp_59=`    pp = sin(px.x * sc + px.y * sc * 0.35 + t);
comp_60=`    s2 = sin(px.y * sc * 0.83 - t * 0.72);
comp_61=`    dg = sin((px.x + px.y) * sc * 0.62 + t * 0.31);
comp_62=`    o.x += (pp * 0.72 + dg * 0.28) * la;
comp_63=`    o.y += (s2 * 0.62 - dg * 0.24) * la;
comp_64=`    sh = sin(px.x * 0.113 / unit + px.y * 0.071 / unit + t * 1.37);
comp_65=`    o += float2(sh, -sh * 0.55) * 0.36 * unit;
comp_66=`    float rt = q3;
comp_67=`    float cyc;
comp_68=`    float idx;
comp_69=`    float2 dp;
comp_70=`    float age;
comp_71=`    cyc = rt * (0.28 + hsh(3.19) * 0.18) + hsh(2.31);
comp_72=`    idx = floor(cyc);
comp_73=`    dp = float2((0.08 + hsh(5.47 + idx * 11.17) * 0.84) * texsize.x, (0.10 + hsh(8.91 + idx * 13.31) * 0.80) * texsize.y);
comp_74=`    o += ripple(px, dp, cyc - idx, 1.4 * unit, 58.0 * unit, unit);
comp_75=`    cyc = rt * (0.28 + hsh(6.38) * 0.18) + hsh(4.62);
comp_76=`    idx = floor(cyc);
comp_77=`    dp = float2((0.08 + hsh(10.94 + idx * 11.17) * 0.84) * texsize.x, (0.10 + hsh(17.82 + idx * 13.31) * 0.80) * texsize.y);
comp_78=`    o += ripple(px, dp, cyc - idx, 1.4 * unit, 58.0 * unit, unit);
comp_79=`    cyc = rt * (0.28 + hsh(9.57) * 0.18) + hsh(6.93);
comp_80=`    idx = floor(cyc);
comp_81=`    dp = float2((0.08 + hsh(16.41 + idx * 11.17) * 0.84) * texsize.x, (0.10 + hsh(26.73 + idx * 13.31) * 0.80) * texsize.y);
comp_82=`    o += ripple(px, dp, cyc - idx, 1.4 * unit, 58.0 * unit, unit);
comp_83=`    cyc = rt * (0.28 + hsh(12.76) * 0.18) + hsh(9.24);
comp_84=`    idx = floor(cyc);
comp_85=`    dp = float2((0.08 + hsh(21.88 + idx * 11.17) * 0.84) * texsize.x, (0.10 + hsh(35.64 + idx * 13.31) * 0.80) * texsize.y);
comp_86=`    o += ripple(px, dp, cyc - idx, 1.4 * unit, 58.0 * unit, unit);
comp_87=`    age = (time - q11) * 0.4;
comp_88=`    dp = float2(q9, frac(q10)) * texsize.xy;
comp_89=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q10) * 0.3) * step(age, 1.0) * step(0.001, q11), 190.0 * unit, unit);
comp_90=`    age = (time - q14) * 0.4;
comp_91=`    dp = float2(q12, frac(q13)) * texsize.xy;
comp_92=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q13) * 0.3) * step(age, 1.0) * step(0.001, q14), 190.0 * unit, unit);
comp_93=`    age = (time - q17) * 0.4;
comp_94=`    dp = float2(q15, frac(q16)) * texsize.xy;
comp_95=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q16) * 0.3) * step(age, 1.0) * step(0.001, q17), 190.0 * unit, unit);
comp_96=`    age = (time - q20) * 0.4;
comp_97=`    dp = float2(q18, frac(q19)) * texsize.xy;
comp_98=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q19) * 0.3) * step(age, 1.0) * step(0.001, q20), 190.0 * unit, unit);
comp_99=`    age = (time - q23) * 0.4;
comp_100=`    dp = float2(q21, frac(q22)) * texsize.xy;
comp_101=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q22) * 0.3) * step(age, 1.0) * step(0.001, q23), 190.0 * unit, unit);
comp_102=`    age = (time - q26) * 0.4;
comp_103=`    dp = float2(q24, frac(q25)) * texsize.xy;
comp_104=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q25) * 0.3) * step(age, 1.0) * step(0.001, q26), 190.0 * unit, unit);
comp_105=`    age = (time - q29) * 0.4;
comp_106=`    dp = float2(q27, frac(q28)) * texsize.xy;
comp_107=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q28) * 0.3) * step(age, 1.0) * step(0.001, q29), 190.0 * unit, unit);
comp_108=`    age = (time - q32) * 0.4;
comp_109=`    dp = float2(q30, frac(q31)) * texsize.xy;
comp_110=`    o += ripple(px, dp, saturate(age), 5.5 * unit * (0.7 + floor(q31) * 0.3) * step(age, 1.0) * step(0.001, q32), 190.0 * unit, unit);
comp_111=`    sh = sin(px.x * 0.097 / unit + px.y * 0.083 / unit + rt * 3.0);
comp_112=`    o += float2(sh, -sh * 0.45) * 0.12 * unit;
comp_113=`    float ol = length(o);
comp_114=`    o *= min(1.0, 30.0 * unit / max(ol, 0.0001));
comp_115=`    float e = min(min(px.x, texsize.x - px.x), min(px.y, texsize.y - px.y));
comp_116=`    float2 ao = o * smoothstep(0.0, 18.0 * unit, e);
comp_117=`    off += ao;
comp_118=`    float2 sp = px + off;
comp_119=`    float r = 1.2 * unit;
comp_120=`    float2 h1 = float2(r, 0.0);
comp_121=`    float2 h2 = float2(0.5 * r, 0.866 * r);
comp_122=`    float2 h3 = float2(-0.5 * r, 0.866 * r);
comp_123=`    float3 cg = cover(sp) * 0.22 + (cover(sp + h1) + cover(sp - h1) + cover(sp + h2) + cover(sp - h2) + cover(sp + h3) + cover(sp - h3)) * 0.13;
comp_124=`    float3 col = cg;
comp_125=`    col.x = lerp(cg.x, cover(sp - chroma).x, saturate(length(chroma) * 4.0));
comp_126=`    col.z = lerp(cg.z, cover(sp + chroma).z, saturate(length(chroma) * 4.0));
comp_127=`    float luma = dot(col, float3(0.299, 0.587, 0.114));
comp_128=`    col = saturate(lerp(float3(luma, luma, luma), col, 1.1));
comp_129=`    col += (tex2D(sampler_noise_hq, uv * texsize.xy / 256.0).x - 0.5) * 0.02;
comp_130=`    float2 slope = ao / (30.0 * unit);
comp_131=`    float glint = pow(saturate(dot(slope, float2(0.6, -0.8)) * 1.6), 6.0);
comp_132=`    col += float3(0.9, 0.97, 1.0) * glint * (0.12 + 0.6 * q2);
comp_133=`    col += float3(0.55, 0.75, 0.9) * saturate(length(slope) * 1.2) * 0.12;
comp_134=`    float2 hl = uv - float2(0.3 + 0.4 * sin(time * 0.07), 0.15);
comp_135=`    col += float3(1.0, 1.0, 1.0) * 0.06 * exp(-dot(hl, hl) * 6.0);
comp_136=`    ret = col;
comp_137=`}
